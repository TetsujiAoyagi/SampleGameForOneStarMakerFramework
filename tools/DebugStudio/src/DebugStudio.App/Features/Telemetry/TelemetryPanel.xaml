<UserControl x:Class="DebugStudio.App.Features.Telemetry.TelemetryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontWeight="SemiBold" Text="Telemetry" />

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Telemetry Frames" />
                    <TextBlock FontSize="24" Text="{Binding TelemetryCount}" />
                    <TextBlock Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{Binding TelemetryStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Service Status Frames" />
                    <TextBlock FontSize="24" Text="{Binding ServiceStatusCount}" />
                    <TextBlock Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{Binding ServiceStatusState}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Latest Telemetry" />
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="{Binding LatestTelemetry}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Latest Service Status" />
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="{Binding LatestServiceStatus}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Recent Telemetry" />
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            BorderBrush="#223A3A3A"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentTelemetry}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,6"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Recent Service Status" />
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            BorderBrush="#223A3A3A"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentServiceStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,6"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock FontWeight="SemiBold" Text="Telemetry Export" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <ComboBox Width="160"
                              Margin="0,0,12,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}" />
                    <Button Width="180"
                              Margin="12,0,0,0"
                              HorizontalAlignment="Right"
                              Command="{Binding ExportCommand}"
                              Content="{Binding ExportButtonLabel}"
                              DockPanel.Dock="Right" />
                    <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0"
                           Foreground="#FF666666"
                           TextWrapping="Wrap"
                           Text="{Binding ExportStatus}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
