<UserControl x:Class="DebugStudio.App.Features.LogViewer.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logcat="clr-namespace:DebugStudio.App.Features.LogViewer">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Padding="8"
            Background="#FFF7F7FA"
            BorderBrush="#FFD0D4DC"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Single toolbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Margin="0,0,6,0"
                         MinHeight="28"
                         VerticalContentAlignment="Center"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="1"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding UseRegex, Mode=TwoWay}"
                          Content="Regex" />
                <ComboBox Grid.Column="2"
                          Margin="0,0,6,0"
                          MinHeight="28"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding KindFilters}"
                          SelectedItem="{Binding SelectedKindFilter, Mode=TwoWay}" />
                <ComboBox Grid.Column="3"
                          Margin="0,0,6,0"
                          MinHeight="28"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />
                <Button Grid.Column="4"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Command="{Binding ClearQueryCommand}"
                        Content="Clear" />
                <Button Grid.Column="5"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Command="{Binding ToggleAutoScrollCommand}"
                        Content="{Binding TailToggleButtonText}" />
                <CheckBox Grid.Column="6"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsCompactDensityEnabled, Mode=TwoWay}"
                          Content="Compact" />
                <Button Grid.Column="7"
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Command="{Binding ToggleDetailPaneCommand}"
                        Content="{Binding DetailToggleButtonText}" />
                <StackPanel Grid.Column="8"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#FF5F6368"
                               Text="{Binding FilterSummary}" />
                    <TextBlock Margin="0,2,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#FF5F6368"
                               Text="{Binding TailStateText}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,4,0,0"
                       Foreground="#FFB91C1C"
                       Text="{Binding ValidationError}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Export (collapsed by default) -->
            <Expander Grid.Row="2"
                      Margin="0,6,0,0"
                      Header="Export"
                      IsExpanded="False">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,8,0"
                             MinHeight="28"
                             VerticalContentAlignment="Center"
                             Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1"
                              Margin="0,0,8,0"
                              MinHeight="28"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}" />
                    <Button Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Command="{Binding ExportCommand}"
                            Content="{Binding ExportButtonText}" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Foreground="#FF5F6368"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ExportStatus}" />
                </Grid>
            </Expander>

            <!-- List left / Detail right -->
            <Grid Grid.Row="3"
                  Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding DetailSplitterColumnWidth}" />
                    <ColumnDefinition Width="{Binding DetailPaneColumnWidth}"
                                      MinWidth="{Binding DetailPaneMinWidth}" />
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        BorderBrush="#FFD9DCE3"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top"
                                Padding="8,6"
                                Background="#FFF4F6FA"
                                BorderBrush="#FFE5E7EB"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" FontSize="11" Text="Time" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="11" Text="Level" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="11" Text="Category" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="11" Text="Message" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListBox x:Name="LogEntriesList"
                                     ItemsSource="{Binding VisibleLogs}"
                                     SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type logcat:LogViewerListItemViewModel}">
                                        <Grid Margin="8,2"
                                              MinHeight="22">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding TimestampText}" />
                                            <Border Grid.Column="1"
                                                    Width="56"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding KindBadgeBackground}"
                                                    CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center"
                                                           Foreground="{Binding KindBadgeForeground}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding KindText}" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Margin="0,0,8,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="#FF374151"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Category}" />
                                            <TextBlock Grid.Column="3"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Message}" />

                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="4"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#FF6B7280"
                                                       Text="{Binding SecondaryLine}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsCompactDensityEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="4"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#FFB91C1C"
                                                       Text="{Binding ExceptionPreview}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasException}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsCompactDensityEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF5F6368"
                                       Text="{Binding EmptyStateText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleLogs}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#FFE5E7EB"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#FFD9DCE3"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Selected Entry" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedLogTitle, Mode=OneWay}" />
                        </StackPanel>

                        <TabControl Grid.Row="1"
                                    Margin="0,8,0,0">
                            <TabItem Header="Overview">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="80" />
                                        <RowDefinition Height="*" MinHeight="100" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Foreground="#FF5F6368"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{Binding DetailEmptyState, Mode=OneWay}" />
                                    <ListView Grid.Row="1"
                                              Margin="0,8,0,8"
                                              ItemsSource="{Binding DetailFields}"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="90" Header="Field" DisplayMemberBinding="{Binding Label}" />
                                                <GridViewColumn Width="180" Header="Value" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <DockPanel Grid.Row="2"
                                               LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top"
                                                   Margin="0,0,0,4"
                                                   FontWeight="SemiBold"
                                                   Text="Message" />
                                        <StackPanel DockPanel.Dock="Bottom"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasSelectedLogException, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="0,0,0,4"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFB91C1C"
                                                       Text="Exception" />
                                            <TextBox MinHeight="96"
                                                     MaxHeight="220"
                                                     IsReadOnly="True"
                                                     Text="{Binding SelectedLogException, Mode=OneWay}"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     Foreground="#FFB91C1C" />
                                        </StackPanel>
                                        <TextBox IsReadOnly="True"
                                                 Text="{Binding SelectedLogMessage, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="11" />
                                    </DockPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Structured">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Foreground="#FF5F6368"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{Binding StructuredPayloadStatus, Mode=OneWay}" />
                                    <ListView Grid.Row="1"
                                              Margin="0,8,0,0"
                                              ItemsSource="{Binding StructuredFields}"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Visibility="{Binding HasStructuredFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="120" Header="Path" DisplayMemberBinding="{Binding Label}" />
                                                <GridViewColumn Width="160" Header="Value" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
