<UserControl x:Class="DebugStudio.App.Features.Commands.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontWeight="SemiBold" Text="Command" />

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Dispatches" />
                    <TextBlock FontSize="24" Text="{Binding DispatchCount}" />
                    <TextBlock Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{Binding LastRequestId}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Command Results" />
                    <TextBlock FontSize="24" Text="{Binding ResultCount}" />
                    <TextBlock Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{Binding ResultStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock FontWeight="SemiBold" Text="Pending Correlation" />
                    <TextBlock FontSize="24" Text="{Binding PendingCount}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding DispatchStatus}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FF666666"
                                TextWrapping="Wrap"
                                Text="{Binding TransportSummary}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Command Type" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Text="{Binding BuiltInCommandGuide}" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding CommandType, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Payload JSON" />
                    <TextBox Margin="0,8,0,0"
                             MinHeight="64"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Text="{Binding PayloadJson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="4"
                        MinWidth="120"
                        Padding="16,8"
                        VerticalAlignment="Bottom"
                        Command="{Binding SendCommand}"
                        Content="Send" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock FontWeight="SemiBold" Text="Latest Result" />
                <TextBlock Margin="0,8,0,0"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Text="{Binding LatestResult}" />
                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Latest Payload JSON" />
                <TextBox Margin="0,8,0,0"
                         MinHeight="96"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Text="{Binding LatestPayloadJson, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock FontWeight="SemiBold" Text="Recent Commands" />
                <ListView Margin="0,8,0,0"
                          ItemsSource="{Binding History}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="120" Header="State" DisplayMemberBinding="{Binding State}" />
                            <GridViewColumn Width="220" Header="RequestId" DisplayMemberBinding="{Binding RequestId}" />
                            <GridViewColumn Width="180" Header="CommandType" DisplayMemberBinding="{Binding CommandType}" />
                            <GridViewColumn Width="380" Header="Summary" DisplayMemberBinding="{Binding Summary}" />
                            <GridViewColumn Width="260" Header="Timing" DisplayMemberBinding="{Binding Timing}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
