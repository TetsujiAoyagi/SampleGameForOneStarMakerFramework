<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:logcat="clr-namespace:DebugStudio.App.Features.LogViewer" xmlns:session="clr-namespace:DebugStudio.App.Features.Session" xmlns:telemetry="clr-namespace:DebugStudio.App.Features.Telemetry" xmlns:commands="clr-namespace:DebugStudio.App.Features.Commands" xmlns:hierarchy="clr-namespace:DebugStudio.App.Features.Hierarchy" xmlns:inspector="clr-namespace:DebugStudio.App.Features.Inspector">

    <DataTemplate DataType="{x:Type session:SessionWindowViewModel}">
        <session:SessionPanel />
    </DataTemplate>

    <DataTemplate DataType="{x:Type logcat:LogViewerViewModel}">
        <logcat:LogViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type telemetry:TelemetryWindowViewModel}">
        <telemetry:TelemetryPanel />
    </DataTemplate>

    <DataTemplate DataType="{x:Type commands:CommandWindowViewModel}">
        <commands:CommandPanel />
    </DataTemplate>

    <DataTemplate DataType="{x:Type hierarchy:HierarchyViewModel}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock FontWeight="SemiBold" Text="Hierarchy snapshot" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FF5B6572"
                           Text="{Binding Summary, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           TextWrapping="Wrap"
                           Text="{Binding EmptyState, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           TextWrapping="Wrap"
                           Text="{Binding SelectionSummary, Mode=OneWay}" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button Width="180"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ExportCommand}"
                            Content="Export Hierarchy NDJSON"
                            DockPanel.Dock="Right" />
                    <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           TextWrapping="Wrap"
                           Text="{Binding ExportStatus, Mode=OneWay}" />
            </StackPanel>

            <ListView ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      FontFamily="Consolas"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="220" Header="Node" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Width="100" Header="Type" DisplayMemberBinding="{Binding TypeLabel}" />
                        <GridViewColumn Width="120" Header="Flags" DisplayMemberBinding="{Binding FlagsText}" />
                        <GridViewColumn Width="90" Header="Id" DisplayMemberBinding="{Binding NodeId}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:InspectorViewModel}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock FontWeight="SemiBold" Text="Selected detail" />
                <TextBlock Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding TargetTitle, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           Text="{Binding Summary, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage, Mode=OneWay}" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button Width="180"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ExportCommand}"
                            Content="Export Inspector NDJSON"
                            DockPanel.Dock="Right" />
                    <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF5B6572"
                           TextWrapping="Wrap"
                           Text="{Binding ExportStatus, Mode=OneWay}" />
            </StackPanel>

            <ListView ItemsSource="{Binding Properties}"
                      FontFamily="Consolas"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="120" Header="Section" DisplayMemberBinding="{Binding SectionName}" />
                        <GridViewColumn Width="140" Header="Field" DisplayMemberBinding="{Binding PropertyName}" />
                        <GridViewColumn Width="180" Header="Value" DisplayMemberBinding="{Binding ValueText}" />
                        <GridViewColumn Width="90" Header="Type" DisplayMemberBinding="{Binding TypeText}" />
                        <GridViewColumn Width="90" Header="Flags" DisplayMemberBinding="{Binding FlagsText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
