// 対応パネル: D2-4（CPU p95） / D2-5（fps p05） / D2-6（メモリ最大）
//
// !!! 現在このクエリは 0 行を返す。構文エラーではない。 !!!
//   ProfilerSummary が Unity から 1 件も emit されていないため（2026-08-11 実測）。
//   発生源 DebugProfilerView は UIView だがプロジェクト全体で呼び出し側が 1 つも無く、
//   Debug レイヤーに積まれることが無い。詳細は
//   docs/planning/KIBANA_DASHBOARD_CONTENT_HANDOFF_2026-08-11.md §7 の K3-3 節。
//   このファイルは「何を集計したいか」の正本として先に置いてある（§1.3）。
//   ProfilerSummary が流れるようになった時点で、そのままパネルに起こせる。
//
// 統計量の選び方（§2.2）:
//   cpuMs は p95。平均は「ほとんどの時間が暇」に引っ張られて鈍い
//   fps は p05。平均 fps は無意味で、効くのは悪い方の裾
//   managedBytes は最大。ピークが上がっていれば重くなっている
//
// percentile は BY sessionId の中で取る（§2.3）。run をまたいで取らない。
//
// gpuMs は意図的に出していない: payload.gpuAvailable == false のとき gpuMs は
// 意味を持たない（付録 A.1）。混ぜて集計すると嘘になるので、GPU は
// gpuAvailable で絞った別クエリにする。

FROM debugstudio-telemetry-*
| WHERE kind == "sample" AND name == "ProfilerSummary" AND sessionId IS NOT NULL
| STATS cpuP95 = PERCENTILE(payload.cpuMs, 95),
        fpsP05 = PERCENTILE(payload.fps, 5),
        managedMax = MAX(payload.managedBytes),
        nativeMax = MAX(payload.nativeBytes),
        samples = COUNT(*),
        started = MIN(@timestamp)
    BY sessionId
| SORT started ASC
| LIMIT 20
