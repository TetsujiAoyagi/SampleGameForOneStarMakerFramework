<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DebugStudio.Export\DebugStudio.Export.csproj" />
  </ItemGroup>

  <!--
    ES|QL クエリ正本。P-1（「C# に埋め込まない」）に反しない: 製品コードは今も
    これらを持たず、artifact にも出力しない。テストアセンブリだけが「正本ファイルと
    NDJSON の埋め込みクエリが一致しているか」を検算するために原文を必要とする。
    リンク参照ではなく埋め込みにしているのは、実行時の作業ディレクトリに依存せず
    commit されたファイルそのものを読むため。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\elastic\queries\*.esql"
                      LogicalName="DebugStudio.Export.Tests.Elastic.Queries.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
