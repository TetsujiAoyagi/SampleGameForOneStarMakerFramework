-        /// <summary>
-        /// 生成計画に基づき .unity シーンファイルを作成・更新する（テスト対象外）。
-        /// 既存ファイルはスキップし、冪等に保つ。
-        /// </summary>
-        /// <param name="definition">グリッド定義。</param>
