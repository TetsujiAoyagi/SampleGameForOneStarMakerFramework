diff --git a/unity/Assets/SampleGame/InGame/InGameSession/Streaming/Runtime/IssuedOperations/SceneTerminalTracker.cs b/unity/Assets/SampleGame/InGame/InGameSession/Streaming/Runtime/IssuedOperations/SceneTerminalTracker.cs
