+++    [TestFixture]
+++    public sealed class RenderEnvironmentLeaseTests
+++    {
+++        private FakeRenderEnvironmentSink _sink = null!;
+++        private RenderEnvironment _environment = null!;
+++        private GameObject? _sunGo;
+++
+++        [SetUp]
