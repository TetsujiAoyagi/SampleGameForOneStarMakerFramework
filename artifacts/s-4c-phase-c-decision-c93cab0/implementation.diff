diff --git a/unity/Assets/OneStarMaker/Scripts/Runtime/Rendering/Environments/internal/RenderEnvironmentValidator.cs b/unity/Assets/OneStarMaker/Scripts/Runtime/Rendering/Environments/internal/RenderEnvironmentValidator.cs
