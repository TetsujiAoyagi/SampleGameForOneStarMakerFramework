++        /// <summary>
++        /// lease 経由の Apply。権利証が生きていて Bind 済みのときだけ sink へ流す。
++        /// 負値は装置へ出さず Validator で閉じる。
++        /// </summary>
++        internal void ApplyFromLease(int generation, in RenderEnvironmentState state)
++        {
++            EnsureLeaseIsActive(generation);
++
