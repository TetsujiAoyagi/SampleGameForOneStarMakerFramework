+        private sealed class FakeInstance : IBackendInstance, IBackendAsset
+        {
+            public GameObject? Instance { get; } = new("fake-content-instance");
+            public UnityEngine.Object? Asset => Instance;
+            public bool IsValid => Instance != null;
+        }
