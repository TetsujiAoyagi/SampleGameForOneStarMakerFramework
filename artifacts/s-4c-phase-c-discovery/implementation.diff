diff --git a/unity/Assets/OneStarMaker/Tests/Rendering/Environments/RenderEnvironmentLeaseTests.cs b/unity/Assets/OneStarMaker/Tests/Rendering/Environments/RenderEnvironmentLeaseTests.cs
new file mode 100644
