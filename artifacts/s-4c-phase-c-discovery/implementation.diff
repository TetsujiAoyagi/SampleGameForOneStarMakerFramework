+```csharp
+private void InitializeRenderEnvironment()
+{
+    if (_renderEnvironment != null)
+    {
+        return;
+    }
+
+    _renderEnvironment = new RenderEnvironment(new UnityRenderEnvironmentSink());
+    if (_renderEnvironmentQuittingHandlerRegistered)
